---
import Base from '../layouts/Base.astro';
import { cta } from '../data/site';
---
<Base title="Page not found | Wedding by Luxury Travel">
  <section class="not-found">
    <div>
      <p class="kicker">Error 404</p>
      <h1 class="h1">Page Not Found</h1>
      <p>The page you are looking for has moved or no longer exists.</p>
      <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn" href="/en">Back to the homepage</a>
        <a class="btn btn--outline" href={cta.href}>{cta.label}</a>
      </p>
    </div>
  </section>
</Base>
