---
// Blog.
// Changes from the review: one design for the article list, each article only
// once; a call to action at the end.
// Hero, mixing the original site and the new one (owner's choice): the title on the
// right as on the original, the brown layer and the plain rose kicker of the new one;
// the first article rises only a little into the photo, so the photo stays visible;
// the round triangle pattern from the logo appears as whole circles in several sizes
// and places down the page (second review).
// Article list ("stories", owner's choice): each article is a wide photo with a cream
// card resting on its edge, alternating sides; the first article is the same idea at a
// larger scale (panoramic photo, card at the bottom right, "Featured").
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import page from '../../data/blog_page.json';
import deco from '../../data/blog_deco.json';
import { blog, seo, plain } from '../../lib/content';
const s = seo['/en/blog'];
const featured = blog.find((b) => (b as any).featured) ?? blog[0];
const rest = blog.filter((b) => b !== featured);
const excerpt = (a: any) => a.excerpt || plain(a.body);
// The round pattern circles. Their place, size and opacity live in src/data/blog_deco.json;
// open the page with ?edit to move them by hand and copy new settings (see site.ts).
const circles = (where: string) => (deco as { where: string; x: number; y: number; size: number; opacity: number }[])
  .map((d, i) => ({ ...d, i })).filter((d) => d.where === where);
const LOGO = '/img/logos/wlt-logoframe-bronze.svg';
---
<Base title={s.title} description={s.description} image={page.hero}>
  <section class="blog-hero">
    <Img name={page.hero} alt={page.hero_alt} sizes="100vw" priority style="object-position:50% 40%" />
    <div class="blog-hero__text">
      <div class="container">
        <p class="kicker">{page.kicker}</p>
        <h1 class="h1">{page.h1}</h1>
      </div>
    </div>
  </section>

  <section class="section blog-list">
    {/* the round triangle pattern of the logo, whole circles in several sizes (owner's request) */}
    {circles('list').map((d) => <img class="deco" data-deco={d.i} data-where={d.where} src={LOGO} alt="" width="640" height="640" loading="lazy" style={`left:${d.x}%;top:${d.y}%;--s:${d.size}px;opacity:${d.opacity}`} />)}
    <div class="container">
      <a class="blog-feature" href={`/en/blog/${featured.slug}`} data-reveal>
        <div class="blog-feature__media"><Img name={featured.card_image || featured.hero} alt={featured.card_alt || featured.hero_alt || ''} sizes="(max-width: 860px) 100vw, 1160px" /></div>
        <div class="blog-feature__card">
          <span class="post-story__label">Featured</span>
          <h2 class="blog-feature__title">{featured.h1}</h2>
          <p class="post-story__text">{excerpt(featured)}</p>
          <span class="post-story__link">Read the article <Icon name="arrow" class="arrow" /></span>
        </div>
      </a>
      <div class="stories">
        {rest.map((a, i) => (
          <a class:list={['post-story', { 'post-story--right': i % 2 === 1 }]} href={`/en/blog/${a.slug}`} data-reveal>
            {circles(`story-${i}`).map((d) => <img class="deco" data-deco={d.i} data-where={d.where} src={LOGO} alt="" width="300" height="300" loading="lazy" style={`left:${d.x}%;top:${d.y}%;--s:${d.size}px;opacity:${d.opacity}`} />)}
            <div class="post-story__media"><Img name={a.card_image || a.hero} alt={a.card_alt || a.hero_alt || ''} sizes="(max-width: 860px) 100vw, 840px" /></div>
            <div class="post-story__card">
              <span class="post-story__label">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="post-story__title">{a.h1}</h2>
              <p class="post-story__text">{excerpt(a)}</p>
              <span class="post-story__link">Read the article <Icon name="arrow" class="arrow" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper blog-organize">
    {circles('organize').map((d) => <img class="deco" data-deco={d.i} data-where={d.where} src={LOGO} alt="" width="640" height="640" loading="lazy" style={`left:${d.x}%;top:${d.y}%;--s:${d.size}px;opacity:${d.opacity}`} />)}
    <div class="container split">
      <div class="split__media" data-reveal><Img name={page.organize_image} alt="Bride and groom kissing on a white terrace overlooking the Santorini caldera" sizes="(max-width: 860px) 92vw, 720px" /></div>
      <div class="prose" data-reveal>
        <h2 class="h2">{page.organize_title}</h2>
        <Fragment set:html={page.organize} />
      </div>
    </div>
  </section>

  <section class="section"><div class="container"><CtaBand /></div></section>
</Base>
