---
// One service.
// Changes from the review: the title sits under the photo (no more covered faces,
// and its background always fits the text) and a thin divider.
// The two options keep the original presentation: a text panel with tabs and two
// slanted photo panels (click a tab or a photo to switch). On phones the photos
// sit side by side under the text, with their labels written across.
import Base from '../../../../layouts/Base.astro';
import Img from '../../../../components/Img.astro';
import Icon from '../../../../components/Icon.astro';
import SectionHead from '../../../../components/SectionHead.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import { services, destinations, DEST_NAMES } from '../../../../lib/content';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const destPages = new Set(destinations.map((d) => d.slug));
const dests = s.destinations.filter((d) => destPages.has(d)); // drop links to pages that do not exist (zakynthos)
const others = services.filter((x) => x.slug !== s.slug).slice(0, 3);
const hero = s.hero || s.card_image;
---
<Base title={s.title} description={s.description || s.card_text} image={hero}>
  <section class="media-hero"><Img name={hero} alt={s.hero_alt || s.h1} sizes="100vw" priority style="object-position:50% 40%" /></section>
  <section class="title-band">
    <h1 class="h1">{s.h1}</h1>
    <hr class="thin-rule" />
    {s.intro_title && <p class="slogan" style="margin:0 auto;max-width:760px">{s.intro_title}</p>}
  </section>

  <section class="section section--tight">
    <div class="container container--narrow prose lead" data-reveal set:html={s.intro} />
  </section>

  {s.variations && (
    <section class="svc-var" data-var aria-labelledby="var-title">
      <div class="svc-var__stage">
        <div class="svc-var__copy">
          <Img name={s.variations.background || s.variations.tabs[0].image} alt="" class="svc-var__bg" sizes="(max-width: 768px) 100vw, 40vw" />
          <div class="svc-var__inner">
            <h2 id="var-title" class="svc-var__heading">{s.variations.heading}</h2>
            <div class="svc-var__tabs" role="tablist" aria-label={`${s.variations.heading} options`}>
              {s.variations.tabs.map((t, i) => (
                <button class={`svc-var__tab${i === 0 ? ' is-active' : ''}`} type="button" role="tab" id={`var-tab-${t.key}`} aria-controls={`var-text-${t.key}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1} data-var-key={t.key}>{t.label}</button>
              ))}
            </div>
            {s.variations.tabs.map((t, i) => (
              <p class={`svc-var__text${i === 0 ? ' is-active' : ''}`} role="tabpanel" id={`var-text-${t.key}`} aria-labelledby={`var-tab-${t.key}`} aria-hidden={String(i !== 0)} data-var-text data-var-key={t.key}>{t.text}</p>
            ))}
          </div>
        </div>
        {s.variations.tabs.map((t, i, all) => (
          <button class={`svc-var__panel${i === 0 ? ' is-active' : ''}${i === all.length - 1 ? ' is-trailing' : ''}`} type="button" tabindex="-1" aria-hidden="true" data-var-panel data-var-key={t.key} data-pos={i + 1}>
            <Img name={t.image || s.variations.background} alt="" sizes="(max-width: 768px) 50vw, 34vw" />
            <span class="svc-var__spine">{t.label}</span>
          </button>
        ))}
      </div>
    </section>
  )}

  {dests.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead title={s.dest_title || s.h1} subtitle={s.dest_subtitle || undefined} />
        <nav class="dest-links" aria-label="Destinations">
          {dests.map((d) => <a class="pill" href={`/en/wedding/destinations/${d}`}>{DEST_NAMES[d]}</a>)}
        </nav>
      </div>
    </section>
  )}

  <section class="section section--rose">
    <div class="container">
      <SectionHead title="More for Your Wedding" subtitle="Discover our other services" />
      <div class="venues">
        {others.map((o) => (
          <a class="photo-card" href={`/en/wedding/servicepackages/${o.slug}`} style="height:280px">
            <Img name={o.card_image} alt="" sizes="(max-width: 600px) 92vw, 400px" />
            <span class="photo-card__body">
              <span class="photo-card__title">{o.card_title}</span>
              <span class="link-arrow">Explore <Icon name="arrow" class="arrow" /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section"><div class="container"><CtaBand /></div></section>
</Base>
