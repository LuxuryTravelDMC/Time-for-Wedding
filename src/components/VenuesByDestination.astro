---
// Wedding venues grouped by destination. Destinations without venues are not
// shown, and when a destination has two venues both cards are the same size.
import VenueCard from './VenueCard.astro';
import Icon from './Icon.astro';
import { venuesFor, DEST_NAMES, DESTINATIONS } from '../lib/content';
interface Props { only?: string; limit?: number }
const { only, limit = 6 } = Astro.props;
const groups = DESTINATIONS.filter((d) => !only || d === only)
  .map((d) => ({ slug: d, name: DEST_NAMES[d], venues: venuesFor(d) }))
  .filter((g) => g.venues.length > 0);
const first = groups[0]?.slug;
---
{groups.length > 0 && (
  <div data-tabs>
    {groups.length > 1 && (
      <div class="pills" role="tablist" aria-label="Destination">
        {groups.map((g) => (
          <button class="pill" type="button" role="tab" data-tab={g.slug} aria-selected={String(g.slug === first)} tabindex={g.slug === first ? 0 : -1}>{g.name}</button>
        ))}
      </div>
    )}
    {groups.map((g) => (
      <div data-tab-panel={g.slug} role="tabpanel" hidden={g.slug !== first}>
        <div class="venues" data-count={Math.min(g.venues.length, 3)}>
          {g.venues.slice(0, limit).map((v) => <VenueCard venue={v} />)}
        </div>
        <p class="center" style="margin-top: 36px">
          <a class="btn btn--outline" href={`/en/wedding/places/${g.slug}`}>All venues in {g.name} <Icon name="arrow" class="arrow" /></a>
        </p>
      </div>
    ))}
  </div>
)}
