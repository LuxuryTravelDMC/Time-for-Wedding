---
import Icon from './Icon.astro';
---
<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Photo viewer">
  <img src="" alt="" />
  <button class="lightbox__btn lightbox__close" type="button" data-close aria-label="Close"><Icon name="close" /></button>
  <button class="lightbox__btn lightbox__prev" type="button" data-prev aria-label="Previous photo"><Icon name="arrow-left" /></button>
  <button class="lightbox__btn lightbox__next" type="button" data-next aria-label="Next photo"><Icon name="arrow" /></button>
  <p class="lightbox__count" data-count></p>
</div>
