---
// A list of venue cards. Phones: two or more venues are a slider (swipe or arrows).
// Larger screens: desktop="carousel" slides when more than 3; desktop="grid" shows rows.
import VenueCard from './VenueCard.astro';
import Carousel from './Carousel.astro';
interface Props { venues: any[]; label: string; desktop?: 'carousel' | 'grid' }
const { venues, label, desktop = 'grid' } = Astro.props;
---
{venues.length === 1 ? (
  <div class="venues" data-count="1"><VenueCard venue={venues[0]} /></div>
) : (
  <Carousel label={label} count={venues.length} desktop={desktop} item="venues">
    {venues.map((v) => <VenueCard venue={v} />)}
  </Carousel>
)}
