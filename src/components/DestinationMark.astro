---
// The destinations written along the W of the logo, as on the old site: one line of
// names inside each slanted stroke and one in each gap between the shapes (owner's
// choice, option A), so the names alternate shape / space / shape / space.
// The names are measured with the letter widths of Philosopher Bold Italic, spread
// over the four lines so the lines come out about equally full, and spaced evenly
// inside each line. Everything is one SVG, so it scales the same on every screen.
// A destination without a page (Zakynthos) is shown without a link.
interface Dest { name: string; href?: string }
interface Props { dests: Dest[]; label?: string }
const { dests, label = 'Wedding destinations' } = Astro.props;

// The W of the logo (wlogo.svg on the old site), 257.57 × 169.52 units.
const PATH = 'M60.82,0H1.54C.69,0,0,.69,0,1.54v2.71c0,.85.69,1.55,1.54,1.55h19.35c.57,0,1.1.31,1.36.82l86.19,162.08c.27.5.79.82,1.36.82s1.09-.31,1.36-.82l19.89-37.22c.24-.45.24-1,0-1.45L62.17.82c-.27-.51-.79-.82-1.36-.82h.01ZM135.49,6.55c.28-.47.78-.75,1.32-.75h18.48c.85,0,1.54-.69,1.54-1.55V1.54C156.83.69,156.14,0,155.29,0h-64.59c-.54,0-1.04.28-1.32.75s-.29,1.04-.04,1.52l88.51,166.43c.27.5.79.82,1.36.82s1.09-.31,1.36-.82l19.89-37.22c.24-.45.24-1,0-1.45L135.45,8.07c-.26-.48-.24-1.06.04-1.52h0ZM243.75.67c-8.86-2.37-17.78,1.76-21.86,9.45l-6.48,12.23c-.27.51-.79.82-1.36.82s-1.09-.31-1.36-.81l-6.59-12.3c-4.11-7.67-13.03-11.77-21.88-9.37-12.46,3.37-17.21,17.02-11.14,28.41l38.25,71.7c.54,1.01,1.59,1.64,2.73,1.64s2.19-.63,2.72-1.64l38.17-71.73c6.07-11.41,1.3-25.06-11.19-28.4h0Z';

// Letter widths of Philosopher Bold Italic (share of the font size) + the 0.06em tracking
const GLYPH: Record<string, number> = { A: .647, B: .646, C: .68, D: .737, E: .602, F: .542, G: .734, H: .723, I: .307, J: .28, K: .694, L: .567, M: .869, N: .695, O: .735, P: .58, Q: .737, R: .616, S: .562, T: .577, U: .697, V: .637, W: .905, X: .645, Y: .639, Z: .599, ' ': .25 };
const TRACK = 0.06;
const textWidth = (s: string, f: number) => [...s].reduce((w, ch) => w + (GLYPH[ch] ?? 0.65), 0) * f + TRACK * f * (s.length - 1);

// All lines run at 62°, the angle of the strokes (direction d). n points across them. Every
// line is placed by its distance v from the left edge of the left stroke (P0) and by how far
// along it the text may run (t0..t1): one line inside each stroke and one in each gap
// between the shapes (left stroke | gap | middle stroke | gap before the heart). The lengths
// were measured on the shape itself for names 13.5 units high, with a small margin from every edge.
const len = Math.hypot(86.19, 162.08);
const d = [86.19 / len, 162.08 / len], n = [d[1], -d[0]];
const ANGLE = (Math.atan2(d[1], d[0]) * 180) / Math.PI;
const P0 = [22.25, 6.62];
const LANES = [ // reading order: right to left
  { v: 104, t0: 60, t1: 235.5 },  // gap between the middle stroke and the heart
  { v: 75.5, t0: 41, t1: 202.5 }, // inside the middle stroke
  { v: 45.2, t0: 25, t1: 204.5 }, // gap between the two strokes
  { v: 14, t0: 8, t1: 170 },      // inside the left stroke
];
const INSET = 2;

function layout(f: number) {
  const lines = LANES.map((l) => ({ ...l, items: [] as number[] }));
  const names = dests.map((x) => x.name.toUpperCase());
  const room = (l: typeof lines[number], extra = 0) => l.t1 - l.t0 - l.items.reduce((w, i) => w + textWidth(names[i], f) + f, 0) - extra;
  // Longest names first, each into the line that keeps the most room
  [...names.keys()].sort((a, b) => textWidth(names[b], f) - textWidth(names[a], f)).forEach((i) => {
    const w = textWidth(names[i], f) + f;
    lines.reduce((best, l) => (room(l, w) > room(best, w) ? l : best)).items.push(i);
  });
  let fits = true;
  const placed = lines.flatMap((l) => {
    l.items.sort((a, b) => a - b);
    const used = l.items.reduce((w, i) => w + textWidth(names[i], f), 0);
    const e = (l.t1 - l.t0 - 2 * INSET - used) / (2 * Math.max(1, l.items.length)); // equal space around every name
    if (l.items.length && e < 0.5 * f) fits = false;
    let t = l.t0 + INSET + e;
    return l.items.map((i) => {
      const x = P0[0] + l.v * n[0] + t * d[0], y = P0[1] + l.v * n[1] + t * d[1];
      t += textWidth(names[i], f) + 2 * e;
      return { ...dests[i], text: names[i], x: +x.toFixed(2), y: +y.toFixed(2) };
    });
  });
  return { fits, placed };
}

// 13.5 units at most (the size the lanes were measured for); smaller only if the names don't fit
let size = 13.5, result = layout(size);
while (!result.fits && size > 8) { size -= 0.25; result = layout(size); }
const placed = result.placed;
---
<nav class="dest-mark" aria-label={label}>
  <svg viewBox="-4 -4 265.57 177.52" font-size={size}>
    <path class="dest-mark__shape" d={PATH} />
    {placed.map((p) => {
      const t = <text x={p.x} y={p.y} transform={`rotate(${ANGLE.toFixed(2)} ${p.x} ${p.y})`}>{p.text}</text>;
      return p.href ? <a href={p.href} aria-label={p.name}>{t}</a> : <g role="text" aria-label={p.name}>{t}</g>;
    })}
  </svg>
</nav>
