---
// Couple pages: the top photos one at a time, full width, changing by themselves
// every 5 seconds in an endless loop (soft cross-fade with a slow zoom). Arrows, dots
// and swipe change them by hand. Uses the shared [data-slider] script.
import Img from './Img.astro';
import Icon from './Icon.astro';
interface Props { photos: string[]; alt: string }
const { photos, alt } = Astro.props;
const list = photos.slice(0, 3);
---
<section class="hero-slider" data-slider data-interval="5000" aria-roledescription="carousel" aria-label={`${alt}, photos`}>
  {list.map((p, i) => (
    <div class:list={['hero-slider__slide', { 'is-active': i === 0 }]} data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${list.length}`}>
      <Img name={p} alt={`${alt}, photo ${i + 1}`} sizes="100vw" priority={i === 0} loading="eager" />
    </div>
  ))}
  {list.length > 1 && (
    <>
      <button class="hero-slider__nav hero-slider__prev" type="button" data-prev aria-label="Previous photo"><Icon name="arrow-left" /></button>
      <button class="hero-slider__nav hero-slider__next" type="button" data-next aria-label="Next photo"><Icon name="arrow" /></button>
      <div class="hero-slider__dots">
        {list.map((_, i) => <button type="button" data-dot aria-label={`Photo ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}
      </div>
    </>
  )}
</section>
