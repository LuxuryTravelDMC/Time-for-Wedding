---
// Irina's section. The button now says what it does: it opens the request form.
import Img from './Img.astro';
import Icon from './Icon.astro';
---
<section class="section designer">
  <div class="container container--narrow" data-reveal>
    <p class="kicker">Your Wedding Designer</p>
    <Img name="homepage/t4w-irina-whitened" alt="Irina Rud, Lead Wedding Planner at Wedding by Luxury Travel" class="designer__photo" sizes="200px" />
    <h2 class="designer__name">Irina Rud</h2>
    <p class="designer__role">Lead Wedding Planner</p>
    <p class="designer__bio">I'm Irina Rud, a wedding planner who approaches every couple with care, warmth, and a genuine desire to create not just a celebration, but a true story - through details, atmosphere, and emotion.</p>
    <a class="btn btn--outline" href="/en/contact#request">Contact Irina <Icon name="arrow" class="arrow" /></a>
  </div>
</section>
