---
// Five service cards. On phones every card has exactly the same height.
import Img from './Img.astro';
import Icon from './Icon.astro';
const cards = [
  { href: '/en/wedding/servicepackages/tours', title: 'Tailor-made Tours', text: 'Tours for couples across Greece', img: 'services/tailor-made-tour' },
  { href: '/en/wedding/servicepackages/concierge', title: 'Concierge Service', text: '24/7 assistance with your wedding planning', img: 'services/concirge-service-canaves-oia' },
  { href: '/en/wedding/servicepackages/transport', title: 'Premium Transport', text: 'Top-tier wedding cars for your ceremony', img: 'services/premium-transportation' },
  { href: '/en/wedding/servicepackages/accommodation', title: 'Deluxe Accommodation', text: 'Curated hotels & villas for your wedding', img: 'services/deluxe-accomodation' },
  { href: '/en/wedding/servicepackages/yacht', title: 'Yacht Rentals', text: 'Private yacht experiences for two', img: 'services/yacht-rental' },
];
---
<div class="services-grid">
  {cards.map((c, i) => (
    <a class="photo-card" href={c.href} data-reveal style={`transition-delay:${i * 70}ms`}>
      <Img name={c.img} alt="" sizes={i === 0 ? '(max-width: 860px) 92vw, 420px' : '(max-width: 560px) 92vw, (max-width: 860px) 46vw, 420px'} />
      <span class="photo-card__body">
        <span class="photo-card__title">{c.title}</span>
        <span class="photo-card__text" style="display:block">{c.text}</span>
        <span class="link-arrow">Explore <Icon name="arrow" class="arrow" /></span>
      </span>
    </a>
  ))}
</div>
