---
// The frame every page sits in: <head>, fonts, menu and footer.
import '@fontsource/open-sans/latin-300.css';
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-600.css';
import '@fontsource/philosopher/latin-400-italic.css';
import '@fontsource/philosopher/latin-700-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import images from '../data/images.json';

interface Props {
  title: string;
  description?: string;
  image?: string;          // photo name for sharing previews
  overlayHeader?: boolean; // menu inside the first photo (homepage)
  preload?: string;        // photo name of the first big photo, loaded first
}
const { title, description, image, overlayHeader = false, preload } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/en', site.url).href;
const imgMeta = (n?: string) => (n ? (images as Record<string, { widths: number[] }>)[n] : undefined);
const share = image && imgMeta(image) ? new URL(`/img/${image}-${imgMeta(image)!.widths.find((w) => w >= 960) ?? imgMeta(image)!.widths.at(-1)}.webp`, site.url).href : undefined;
const pre = imgMeta(preload);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {site.hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f9eee8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {share && <meta property="og:image" content={share} />}
    <meta name="twitter:card" content="summary_large_image" />
    {pre && preload && (
      <link rel="preload" as="image" type="image/webp" fetchpriority="high"
        imagesrcset={pre.widths.map((w) => `/img/${preload}-${w}.webp ${w}w`).join(', ')} imagesizes="100vw" />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
